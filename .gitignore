# ------------------------------- edbo webapp: runtime state (never commit)
# These hold real experimental results (SQLite DB, dill pickles, descriptor
# CSV uploads) and can be hundreds of MB — they are mounted as a Docker volume
# at run time and recreated automatically when absent.
/webapp/backend/data/
/webapp/backend/data_backup_*/
/webapp/backups/

